# =============================================================================
# AgentOps MCP — Environment Configuration (TEMPLATE — do not commit real values)
# =============================================================================
# Copy this file to .env and fill in real values locally.

# ---- Backend (FastAPI) ----
AGENTOPS_HOST=0.0.0.0
AGENTOPS_PORT=8000
AGENTOPS_ENV=development
AGENTOPS_LOG_LEVEL=INFO

# Required outside development: random value, >= 32 chars. Also keys the API-key HMAC.
AGENTOPS_SECRET_KEY=change-me-to-a-random-string

# Admin token for POST /v1/admin/* (project/agent/API-key registration). Admin API is off if unset.
AGENTOPS_ADMIN_TOKEN=change-me-admin-token

# Optional: full DB URL override (otherwise built from POSTGRES_*). Tests/dev may use sqlite:///./dev.db
AGENTOPS_DATABASE_URL=

# Dev convenience only; use `alembic upgrade head` for real environments.
AGENTOPS_AUTO_CREATE_TABLES=false
AGENTOPS_AUTO_REGISTER_AGENTS=true
AGENTOPS_MAX_PAYLOAD_BYTES=1048576
AGENTOPS_MAX_BATCH_SIZE=100

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=change-me

# ---- Prometheus ----
PROMETHEUS_URL=http://localhost:9090
AGENTOPS_METRICS_TOKEN=change-me-metrics-token

# ---- Grafana ----
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Tempo (Trace backend) ----
TEMPO_URL=http://localhost:3200
OTLP_GRPC_ENDPOINT=localhost:4317
OTLP_HTTP_ENDPOINT=http://localhost:4318
AGENTOPS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
AGENTOPS_TRACE_SAMPLE_RATIO=1.0
AGENTOPS_SERVICE_NAME=agentops-backend

# ---- Phase 5: Trace Details and Run History ----
# Set to true to include optional payload summaries in timeline responses (off by default for privacy).
AGENTOPS_PAYLOAD_CAPTURE_ENABLED=false
# Retention policy (days). Used to compute trace_data_may_have_expired in the timeline API.
AGENTOPS_RUN_RETENTION_DAYS=90
AGENTOPS_TRACE_RETENTION_DAYS=30
# Base URL of the Grafana / OTLP UI for deep-link generation. Leave blank to disable links.
AGENTOPS_OTLP_UI_BASE_URL=http://localhost:3000


# ---- Phase 7: MCP server (read-only tools) ----
# AgentOps API key with the 'read' scope used by the stdio MCP server. Placeholder only.
AGENTOPS_MCP_API_KEY=
# Default query window (hours) when a tool call omits a time range.
AGENTOPS_MCP_DEFAULT_WINDOW_HOURS=24
# Maximum query window (days); wider requests are rejected.
AGENTOPS_MCP_MAX_WINDOW_DAYS=30
# Maximum rows returned by list-style tools (1-100).
AGENTOPS_MCP_MAX_RESULTS=50

# ---- Phase 8: AI Diagnostic Assistant (read-only; OFF unless provider + real key + model are set) ----
# Provider: none | groq | openai | openai_compatible (any OpenAI-style /chat/completions endpoint)
DIAGNOSTIC_LLM_PROVIDER=groq
DIAGNOSTIC_LLM_MODEL=llama3-70b-8192
DIAGNOSTIC_LLM_API_KEY=change-me
# Required for openai_compatible (e.g. http://localhost:11434/v1 for Ollama); optional override otherwise.
DIAGNOSTIC_LLM_BASE_URL=
DIAGNOSTIC_LLM_MAX_TOKENS=1500
DIAGNOSTIC_LLM_MAX_RETRIES=1
# Evidence-retrieval tool calls per investigation, and per-request LLM timeout (seconds).
DIAGNOSTIC_MAX_TOOL_CALLS=15
DIAGNOSTIC_TIMEOUT_SECONDS=120
# Evidence size sent to the model (characters), spans per trace, baseline look-back (days).
DIAGNOSTIC_MAX_CONTEXT_CHARS=24000
DIAGNOSTIC_MAX_SPANS=60
DIAGNOSTIC_BASELINE_DAYS=7

# ---- Phase 9: Security, Reliability, and Performance Hardening ----
# Rate limiting
AGENTOPS_RATE_LIMIT_ENABLED=true
AGENTOPS_RATE_LIMIT_RPM=600
AGENTOPS_RATE_LIMIT_BURST=100

# REST query boundaries
AGENTOPS_REST_MAX_WINDOW_DAYS=90
AGENTOPS_MAX_PAGE_OFFSET=10000

# Database pooling & timeouts
AGENTOPS_DB_POOL_SIZE=10
AGENTOPS_DB_MAX_OVERFLOW=20
AGENTOPS_DB_POOL_TIMEOUT=30
AGENTOPS_DB_POOL_RECYCLE=1800
AGENTOPS_DB_CONNECT_TIMEOUT=10
AGENTOPS_DB_STATEMENT_TIMEOUT_MS=15000

# Security & logging
AGENTOPS_ENABLE_DOCS=false
AGENTOPS_LOG_FORMAT=json

# ---- SDK defaults (used by example agents) ----
AGENTOPS_API_ENDPOINT=http://localhost:8000
AGENTOPS_PROJECT_ID=change-me-project-id
AGENTOPS_API_KEY=change-me
AGENTOPS_MAX_RETRIES=3
AGENTOPS_RETRY_BACKOFF_SECONDS=0.5

# ---- Dashboard ----
DASHBOARD_PORT=3001


