# =============================================================================
# Marg MCP — Environment Configuration (TEMPLATE — do not commit real values)
# =============================================================================
# Copy this file to .env and fill in real values locally.
# Note: Legacy AGENTOPS_* environment variables are also supported for backwards compatibility.

# ---- Backend (FastAPI) ----
MARG_HOST=0.0.0.0
MARG_PORT=8000
MARG_ENV=development
MARG_LOG_LEVEL=INFO

# Required outside development: random value, >= 32 chars. Also keys the API-key HMAC.
MARG_SECRET_KEY=change-me-to-a-random-string

# Admin token for POST /v1/admin/* (project/agent/API-key registration). Admin API is off if unset.
MARG_ADMIN_TOKEN=change-me-admin-token

# Optional: full DB URL override (otherwise built from POSTGRES_*). Tests/dev may use sqlite:///./marg_dev.db
MARG_DATABASE_URL=

# Dev convenience only; use `alembic upgrade head` for real environments.
MARG_AUTO_CREATE_TABLES=false
MARG_AUTO_REGISTER_AGENTS=true
MARG_MAX_PAYLOAD_BYTES=1048576
MARG_MAX_BATCH_SIZE=100

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marg
POSTGRES_USER=marg
POSTGRES_PASSWORD=change-me

# ---- Prometheus ----
PROMETHEUS_URL=http://localhost:9090
MARG_METRICS_TOKEN=change-me-metrics-token

# ---- Grafana ----
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Tempo (Trace backend) ----
TEMPO_URL=http://localhost:3200
OTLP_GRPC_ENDPOINT=localhost:4317
OTLP_HTTP_ENDPOINT=http://localhost:4318
MARG_OTLP_ENDPOINT=http://localhost:4318/v1/traces
MARG_TRACE_SAMPLE_RATIO=1.0
MARG_SERVICE_NAME=marg-backend

# ---- Phase 5: Trace Details and Run History ----
# Set to true to include optional payload summaries in timeline responses (off by default for privacy).
MARG_PAYLOAD_CAPTURE_ENABLED=false
# Retention policy (days). Used to compute trace_data_may_have_expired in the timeline API.
MARG_RUN_RETENTION_DAYS=90
MARG_TRACE_RETENTION_DAYS=30
# Base URL of the Grafana / OTLP UI for deep-link generation. Leave blank to disable links.
MARG_OTLP_UI_BASE_URL=http://localhost:3000

# ---- Phase 7: MCP server (read-only tools) ----
# Marg API key with the 'read' scope used by the stdio MCP server. Placeholder only.
MARG_MCP_API_KEY=
# Default query window (hours) when a tool call omits a time range.
MARG_MCP_DEFAULT_WINDOW_HOURS=24
# Maximum query window (days); wider requests are rejected.
MARG_MCP_MAX_WINDOW_DAYS=30
# Maximum rows returned by list-style tools (1-100).
MARG_MCP_MAX_RESULTS=50

# ---- Phase 8: AI Diagnostic Assistant (read-only; OFF unless provider + real key + model are set) ----
# Provider: none | groq | openai | openai_compatible (any OpenAI-style /chat/completions endpoint)
DIAGNOSTIC_LLM_PROVIDER=groq
DIAGNOSTIC_LLM_MODEL=llama3-70b-8192
DIAGNOSTIC_LLM_API_KEY=change-me
# Required for openai_compatible (e.g. http://localhost:11434/v1 for Ollama); optional override otherwise.
DIAGNOSTIC_LLM_BASE_URL=
DIAGNOSTIC_LLM_MAX_TOKENS=1500
DIAGNOSTIC_LLM_MAX_RETRIES=1
# Evidence-retrieval tool calls per investigation, and per-request LLM timeout (seconds).
DIAGNOSTIC_MAX_TOOL_CALLS=15
DIAGNOSTIC_TIMEOUT_SECONDS=120
# Evidence size sent to the model (characters), spans per trace, baseline look-back (days).
DIAGNOSTIC_MAX_CONTEXT_CHARS=24000
DIAGNOSTIC_MAX_SPANS=60
DIAGNOSTIC_BASELINE_DAYS=7

# ---- Phase 9: Security, Reliability, and Performance Hardening ----
# Rate limiting
MARG_RATE_LIMIT_ENABLED=true
MARG_RATE_LIMIT_RPM=600
MARG_RATE_LIMIT_BURST=100

# REST query boundaries
MARG_REST_MAX_WINDOW_DAYS=90
MARG_MAX_PAGE_OFFSET=10000

# Database pooling & timeouts
MARG_DB_POOL_SIZE=10
MARG_DB_MAX_OVERFLOW=20
MARG_DB_POOL_TIMEOUT=30
MARG_DB_POOL_RECYCLE=1800
MARG_DB_CONNECT_TIMEOUT=10
MARG_DB_STATEMENT_TIMEOUT_MS=15000

# Security & logging
MARG_ENABLE_DOCS=false
MARG_LOG_FORMAT=json

# ---- SDK defaults (used by example agents) ----
MARG_API_ENDPOINT=http://localhost:8000
MARG_PROJECT_ID=change-me-project-id
MARG_API_KEY=change-me
MARG_MAX_RETRIES=3
MARG_RETRY_BACKOFF_SECONDS=0.5

# ---- Dashboard ----
DASHBOARD_PORT=3001
